# Your identity provider (Microsoft Entra External ID, Auth0, Keycloak, ...).
VITE_OIDC_AUTHORITY=https://login.example.com/your-tenant/v2.0
VITE_OIDC_CLIENT_ID=your-portal-client-id
# Scope that makes the provider issue an access token for the API.
VITE_OIDC_SCOPE=openid profile api://pas-api/access
# Where the API lives; /api is proxied to localhost:3000 by `npm run dev`.
VITE_API_BASE=/api
